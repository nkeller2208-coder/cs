{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["."]
}
